# Copy to .env for local development. Never commit .env.
APP_PASSWORD=change-me
SESSION_SECRET=generate-with-python-secrets-token_hex-32

# local = images on disk, no cloud access needed. gcs = the real buckets.
STORAGE_BACKEND=local
LOCAL_MEDIA_DIR=dev-media
DB_PATH=dev.sqlite

# Leave DB_BUCKET empty locally so the database is never snapshotted to the cloud.
DB_BUCKET=
MEDIA_BUCKET=my-stuff-inventory-media

GCP_PROJECT=my-stuff-inventory
# Gemini 3.x is not served from any europe-* region. See specs/001-home-inventory/research.md D1.
GEMINI_LOCATION=global
GEMINI_MODEL=gemini-3.1-flash-lite
